# Top level (super)
super + Return
  alacritty
super + shift + Return
  chromium --profile-directory='Default'
super + a
  volume -t
super + r
  update-dwmblocks
super + space
  dmenu_run
super + q
  bspc node -c
super + shift + q
  for win in $(bspc query -N -n .window); do bspc node "$win" -c; done && bspc quit

# General (super + x / backslash)
super + {backslash,x}; h
  get-help
super + {backslash,x}; w
  wifix
super + {backslash,x}; b
  bluetooth
super + {backslash,x}; c
  saveclip -s
super + {backslash,x}; v
  saveclip
super + {backslash,x}; e
  emoji
super + {backslash,x}; s
  screen
super + {backslash,x}; q
  quitdwm
super + {backslash,x}; a
  volume -s
super + {backslash,x}; k
  pkill -USR1 -x sxhkd

# Layout keys
super + l; m
  bspc desktop -l monocle
super + l; t
  bspc desktop -l tiled
super + l; f
  bspc node -t '~floating'

# Action keys
XF86AudioMute
  volume -m
XF86AudioRaiseVolume
  volume -i
XF86AudioLowerVolume
  volume -d
XF86MonBrightnessDown
  brightness -d 1
XF86MonBrightnessUp
  brightness -i 1
XF86AudioMicMute
  microphone -t
XF86Display
  get-info

# Switching keys
super + {_,shift + }{1-9}
    bspc {desktop -f,node -d} '^{1-9}'
alt + {_,shift + }Tab
	bspc node -f {next,prev}.local.!hidden.window

Print
 screen
